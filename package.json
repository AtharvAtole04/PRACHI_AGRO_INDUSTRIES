{
  "name": "prachi-agro-industries-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "client": "npm run dev --prefix frontend",
    "server": "npm run dev --prefix backend",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "build": "npm run install-all && npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "install-all": "npm install --prefix frontend && npm install --prefix backend",
    "seed": "npm run seed --prefix backend",
    "clear": "npm run clear --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
