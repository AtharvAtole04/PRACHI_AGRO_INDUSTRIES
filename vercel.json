{
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/products/:path*",
      "destination": "/api/products?id=:path*"
    },
    {
      "source": "/api/products",
      "destination": "/api/products"
    },
    {
      "source": "/api/videos/:path*",
      "destination": "/api/videos?id=:path*"
    },
    {
      "source": "/api/videos",
      "destination": "/api/videos"
    },
    {
      "source": "/api/blogs/:path*",
      "destination": "/api/blogs?id=:path*"
    },
    {
      "source": "/api/blogs",
      "destination": "/api/blogs"
    },
    {
      "source": "/api/reviews/:path*",
      "destination": "/api/reviews?id=:path*"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/reviews"
    },
    {
      "source": "/api/categories/:path*",
      "destination": "/api/categories?id=:path*"
    },
    {
      "source": "/api/categories",
      "destination": "/api/categories"
    },
    {
      "source": "/api/crops/:path*",
      "destination": "/api/crops?id=:path*"
    },
    {
      "source": "/api/crops",
      "destination": "/api/crops"
    },
    {
      "source": "/api/content/:path*",
      "destination": "/api/content"
    },
    {
      "source": "/api/content",
      "destination": "/api/content"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/api/revalidate",
      "destination": "/api/revalidate"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
